# LM Studio (OpenAI-compatible local server), used for the interview brain,
# scenario briefing, and feedback scoring.
LLM_BASE_URL="http://127.0.0.1:1234/v1"
LLM_MODEL="google/gemma-4-e4b"
LLM_API_KEY="lm-studio"

# speech-to-speech pipeline (Hugging Face speech-to-speech, conda env `s2s`)
S2S_CONDA_ENV="s2s"
# S2S_PYTHON="C:/Users/you/miniconda3/envs/s2s/python.exe"   # set if auto-detect fails
S2S_WS_HOST="127.0.0.1"
S2S_WS_PORT=8765
S2S_STT="parakeet-tdt"
S2S_TTS="qwen3"
S2S_TTS_REF_AUDIO="C:/Users/Dwain-Admin/Desktop/main_voice.wav"
# S2S_DEVICE="cuda"
# S2S_EXTRA_ARGS=""

# LiveAvatar, needed for "Local, with a face" and "Fully online" modes.
# Get a key at https://app.liveavatar.com/developers
LIVEAVATAR_API_KEY=""
# LIVEAVATAR_AVATAR_ID=""     # default avatar; blank = first public avatar
LIVEAVATAR_SANDBOX=false
